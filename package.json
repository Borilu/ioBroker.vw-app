{
  "name": "iobroker.vw-app",
  "version": "0.10.1",
  "description": "Control the official Volkswagen Android app over Wi-Fi from ioBroker",
  "main": "main.js",
  "type": "commonjs",
  "license": "MIT",
  "author": {
    "name": "Borilu",
    "url": "https://github.com/Borilu",
    "email": "borilu@fn.de"
  },
  "homepage": "https://github.com/Borilu/ioBroker.vw-app#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Borilu/ioBroker.vw-app.git"
  },
  "bugs": {
    "url": "https://github.com/Borilu/ioBroker.vw-app/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "ioBroker",
    "volkswagen",
    "android",
    "climate",
    "smart-home"
  ],
  "files": [
    "main.js",
    "lib/",
    "admin/",
    "scripts/",
    "io-package.json",
    "README.md",
    "docs/",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check-package.js",
    "check:types": "node --check main.js",
    "prepack": "node scripts/check-package.js",
    "lint": "eslint .",
    "test:package": "mocha --timeout 30000 testing/package-files.cjs",
    "test:integration": "mocha --timeout 60000 testing/integration.cjs",
    "release": "release-script",
    "test:unit": "node --test"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "fast-xml-parser": "^5.11.2",
    "yauzl": "^3.4.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2"
  },
  "os": [
    "linux"
  ]
}
